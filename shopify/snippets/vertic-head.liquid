{%- comment -%}
  Loaded from snippets/meta-tags.liquid, inside <head>, on every page.
{%- endcomment -%}
<meta name="theme-color" content="#ffffff">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap">
{{ 'vertic.css' | asset_url | stylesheet_tag }}
{%- unless request.design_mode -%}
  <script>
    // Hidden entrance states apply only when JS runs; a failsafe reveals everything if vertic.js never loads.
    document.documentElement.classList.add('vx-motion');
    setTimeout(function () {
      var r = document.documentElement;
      r.classList.add('vx-ready', 'vx-settled');
      document.querySelectorAll('.vx-tile').forEach(function (t) { t.setAttribute('data-in', ''); });
    }, 3000);
  </script>
{%- endunless -%}
<script src="{{ 'vertic.js' | asset_url }}" defer="defer"></script>
