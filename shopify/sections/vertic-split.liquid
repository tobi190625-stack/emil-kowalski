<div class="vx-split">
  {%- for block in section.blocks -%}
    <a
      class="vx-tile"
      href="{{ block.settings.link | default: routes.all_products_collection_url }}"
      style="--vx-focal: {{ block.settings.focal }};"
      {{ block.shopify_attributes }}
    >
      <div class="vx-tile__media">
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '500, 750, 1000, 1400, 2000',
              sizes: '50vw',
              loading: 'lazy',
              alt: block.settings.image.alt
          }}
        {%- else -%}
          <div class="vx-tile__placeholder"></div>
        {%- endif -%}
      </div>
      <div class="vx-tile__body">
        <h2 class="vx-tile__title">{{ block.settings.label | escape }}</h2>
        <span class="vx-tile__cue">
          {{- section.settings.cue | escape -}}
          {%- render 'vertic-arrow' -%}
        </span>
      </div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Vertic Men / Women",
  "tag": "section",
  "class": "section-vertic-split",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "cue", "label": "Link text", "default": "Shop now" }
  ],
  "blocks": [
    {
      "type": "range",
      "name": "Range",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "focal",
          "label": "Image focus",
          "options": [
            { "value": "50% 20%", "label": "Top" },
            { "value": "50% 50%", "label": "Center" },
            { "value": "50% 80%", "label": "Bottom" }
          ],
          "default": "50% 50%"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Men" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertic Men / Women",
      "blocks": [
        { "type": "range", "settings": { "label": "Men" } },
        { "type": "range", "settings": { "label": "Women" } }
      ]
    }
  ]
}
{% endschema %}
