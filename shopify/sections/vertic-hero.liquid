<section class="vx-hero" style="--vx-focal: {{ section.settings.focal }};">
  <div class="vx-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2600
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2600',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- endif -%}
  </div>

  <div class="vx-hero__content">
    <div>
      {%- if section.settings.heading != blank -%}
        {%- assign words = section.settings.heading | split: ' ' -%}
        <h1 class="vx-hero__title" aria-label="{{ section.settings.heading | escape }}">
          {%- for word in words -%}
            <span class="vx-word" aria-hidden="true"><span style="--i: {{ forloop.index0 }};">{{ word | escape }}</span></span>
            {%- unless forloop.last %} {% endunless -%}
          {%- endfor -%}
        </h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="vx-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="vx-btn vx-hero__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label | escape }}
        {%- render 'vertic-arrow' -%}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vertic banner",
  "tag": "div",
  "class": "section-vertic-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image",
      "info": "Wide photo, at least 2400px across."
    },
    {
      "type": "select",
      "id": "focal",
      "label": "Image focus",
      "options": [
        { "value": "50% 20%", "label": "Top" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "50% 80%", "label": "Bottom" }
      ],
      "default": "50% 50%"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the steep side" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Snowboard and ski apparel, printed to order and shipped across the EU."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Vertic banner" }]
}
{% endschema %}
